{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelfmark",
  "version": "1.1.1",
  "identifier": "app.shelfmark.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Shelfmark",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERTFFODcwQjExMTE5OUUKUldTZUdSR3hjT2poM1ZMcXlKNDZhQ3dMOWMwdTBOemU0ZTJFR1A0cktoWjc0K0RaSUptdHEwRC8K",
      "endpoints": [
        "https://github.com/OrellBuehler/shelfmark/releases/latest/download/latest.json"
      ]
    }
  }
}
